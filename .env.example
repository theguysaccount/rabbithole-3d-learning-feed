# Rabbit Hole settings. All optional: the site builds and runs with none of them.
# On GitHub, set them as repository variables (Settings > Secrets and variables > Actions > Variables).
# They are public values, not secrets. Copy to .env for local builds if you like; .env is git-ignored.

BASE_URL=http://127.0.0.1:4337/rabbithole-3d-learning-feed   # local builds only; the deploy uses SITE_URL or the Pages address
SITE_URL=                          # repo variable: https://<custom domain>, once one is set up (OPERATIONS.md, key 1)
GOATCOUNTER_URL=                   # https://<code>.goatcounter.com/count: cookieless counts (key 2)
PRO_URL=                           # the paid creator tier on other hosting (key 3)
SUPPORT_URL=                       # a donation or sponsor page (key 3)
BUILD_DATE=                        # YYYY-MM-DD: build as of a date (guides dated later stay unpublished)
OUT_DIR=                           # build output (default dist)
AVAILABILITY_FILE=                 # alternative availability file (tests use this)
CHROME=                            # Chrome binary for selftest.mjs, screens.mjs and make-images.mjs
